<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="8"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_remove"
            style="@style/OverlayButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/cd_remove"
            android:src="@drawable/ic_delete" />

        <ImageButton
            android:id="@+id/btn_albums"
            style="@style/OverlayButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/cd_albums"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btn_close"
            style="@style/OverlayButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_prev"
            style="@style/OverlayButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/cd_prev"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btn_pause"
            style="@style/OverlayButton"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:contentDescription="@string/cd_pause"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btn_next"
            style="@style/OverlayButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_next" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/volume_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="36dp"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_volume"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volume"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_volume" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volume_slider"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_video_volume"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/remove_panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_item_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/remove_in_photos"
            style="@style/PanelButton"
            android:layout_marginTop="24dp"
            android:text="@string/remove_in_photos" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remove_in_photos_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/remove_hide"
            style="@style/PanelButton"
            android:layout_marginTop="20dp"
            android:text="@string/remove_hide" />

        <Button
            android:id="@+id/remove_cancel"
            style="@style/PanelButton"
            android:layout_marginTop="12dp"
            android:text="@android:string/cancel" />
    </LinearLayout>
</FrameLayout>
